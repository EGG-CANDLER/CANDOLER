# ============================================================
# CANDOLER backend (Flask) — copy this file to `.env` and fill in.
# Values come from your Supabase project: Settings -> API.
# ============================================================

# Supabase project URL (Settings -> API -> Project URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key — server-side only, NEVER expose to the browser
SUPABASE_SERVICE_KEY=your-service-role-key

# JWT secret used to verify Supabase access tokens (Settings -> API -> JWT Secret)
SUPABASE_JWT_SECRET=your-jwt-secret

# Comma-separated list of allowed frontend origins (CORS)
# Development:
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production (add your Vercel URL, e.g.):
# ALLOWED_ORIGINS=https://candoler.vercel.app,https://your-custom-domain.com

# Path to the trained YOLO model file (default: models/egg_candling_best.pt)
MODEL_PATH=models/egg_candling_best.pt

# Minimum confidence threshold for a prediction to be accepted (default: 0.60)
MIN_CONFIDENCE=0.60

# Enable Flask debug mode (default: false). Never set to "true" in production.
FLASK_DEBUG=false

# ------------------------------------------------------------
# The frontend has its own env file: frontend/.env.example
#   VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, VITE_API_URL
# ------------------------------------------------------------
