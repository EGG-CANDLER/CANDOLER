# ============================================================
# CANDOLER backend (Flask) — copy this file to `.env` and fill in.
# Values come from your Supabase project: Settings -> API.
# ============================================================

# Supabase project URL (Settings -> API -> Project URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key — server-side only, NEVER expose to the browser
SUPABASE_SERVICE_KEY=your-service-role-key

# JWT secret used to verify Supabase access tokens (Settings -> API -> JWT Secret)
SUPABASE_JWT_SECRET=your-jwt-secret

# Comma-separated list of allowed frontend origins (CORS)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------
# The frontend has its own env file: frontend/.env.example
#   VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, VITE_API_URL
# ------------------------------------------------------------
