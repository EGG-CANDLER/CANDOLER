# ============================================================
# CANDOLER frontend (Vite) — copy to `frontend/.env` and fill in.
# ============================================================

# Supabase project URL (Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (safe for the browser)
VITE_SUPABASE_ANON_KEY=your-anon-key

# Flask backend base URL
# Development:
VITE_API_URL=http://localhost:5000
# Production (set this to your Render/HF Spaces backend URL, e.g.):
# VITE_API_URL=https://candoler-api.onrender.com
